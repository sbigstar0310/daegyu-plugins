#!/usr/bin/env bash
#
# srr-qa-preflight - get a React Native / Expo dev-client QA environment into a
#                    testable state, or fail with something actionable.
#
# Part of the srr-qa plugin. Project-agnostic: every app-specific value comes
# from config (see --help).
#
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE_BIN="$SCRIPT_DIR/srr-qa-state"

# ----------------------------------------------------------------------------
# Defaults / globals
# ----------------------------------------------------------------------------
VERBOSE=0
WANT_IOS=0
WANT_ANDROID=0
START_METRO=0
DO_LAUNCH=1
DO_CONNECT=1
OPEN_SIMULATOR_APP=1
BOOT_TIMEOUT=120
CMD_TIMEOUT=30
OVERRIDE_UDID=""
OVERRIDE_SERIAL=""

PROJECT_ROOT=""
CFG_MAIN=""
CFG_LOCAL=""

METRO_PORT=8081
METRO_START_CMD=""
IOS_BUNDLE_ID=""
IOS_UDID=""
IOS_DEVICE_NAME=""
IOS_INSTALL_CMD=""
ANDROID_PACKAGE=""
ANDROID_SERIAL=""
ANDROID_INSTALL_CMD=""
DEV_CLIENT_SCHEME=""
IOS_DEEPLINK_OPENED=0
ANDROID_DEEPLINK_OPENED=0

# summary state
REPO_OK=0
REPO_DETAIL=""
METRO_STATE="UNKNOWN"
METRO_PID=""
METRO_DETAIL=""
IOS_STATUS="NOT_REQUESTED"
IOS_APP_INSTALLED=0
IOS_LAUNCHED=0
IOS_LOGIN_STATE=""
IOS_DETAIL=""
IOS_FIX=""
ANDROID_STATUS="NOT_REQUESTED"
ANDROID_APP_INSTALLED=0
ANDROID_LAUNCHED=0
ANDROID_LOGIN_STATE=""
ANDROID_DETAIL=""
ANDROID_FIX=""

# exit codes
EX_OK=0
EX_DEGRADED=1
EX_USAGE=2
EX_BLOCKED=3
EX_CONFIG=4

# ----------------------------------------------------------------------------
# Logging (human output -> stderr, summary block -> stdout)
# ----------------------------------------------------------------------------
log()  { printf '%s\n' "$*" >&2; }
vlog() { [ "$VERBOSE" -eq 1 ] && printf '+ %s\n' "$*" >&2 || true; }
ok()   { printf '  [ ok ] %s\n' "$*" >&2; }
warn() { printf '  [warn] %s\n' "$*" >&2; }
fail() { printf '  [FAIL] %s\n' "$*" >&2; }
step() { printf '\n== %s\n' "$*" >&2; }
die_usage() { log "error: $*"; log "run '$SCRIPT_NAME --help' for usage"; exit "$EX_USAGE"; }

# collapse to a single line; summary values must never contain newlines
oneline() { printf '%s' "$*" | tr '\n\r' '  ' | sed 's/  */ /g'; }

usage() {
  cat <<'EOF'
srr-qa-preflight - bring the mobile QA environment to a testable state

USAGE
  srr-qa-preflight [ios|android|all] [options]

  Default platform argument is "all".

OPTIONS
  -v, --verbose        Echo each underlying command to stderr.
      --start-metro    If Metro is not listening, start it in the background.
                       Without this flag a stopped Metro is a hard failure -
                       a surprise background process is worse than a clear error.
      --no-launch      Do everything except launching/foregrounding the app.
      --no-connect     Do not open the Expo dev-client deep link after launching.
                       (Use for a bare React Native app with no dev-client.)
      --no-open-sim    Do not bring Simulator.app to the front after booting.
      --udid UDID      iOS: use this simulator instead of the configured one.
      --serial SERIAL  Android: use this adb serial instead of the configured one.
      --boot-timeout N Seconds to wait for a simulator/emulator boot (default 120).
      --timeout N      Per-command timeout in seconds (default 30).
  -h, --help           Show this help.

WHAT IT DOES
  1. Verifies the project root looks like a React Native / Expo project.
  2. Verifies Metro is serving on the configured port (default 8081).
  3. iOS:     boots the configured simulator if needed, verifies the app is
              installed (never runs the slow native build itself).
  4. Android: verifies exactly one usable adb device and that the package is
              installed.
  5. Launches / foregrounds the app on each requested platform.
  6. Cold-starts the app through the Expo dev-client deep link so it actually
     loads from Metro. Launching a dev client by bundle id alone only opens the
     "Development servers" launcher menu, and a dev client that is ALREADY
     running ignores the deep link - hence terminate/force-stop first.
     On Android it also runs `adb reverse` so localhost resolves.
  7. Reports login state per platform by delegating to `srr-qa-state`.

  Loading the bundle is not verified - it can still fail with the dev client's
  "There was a problem loading the project" screen. Look at the screen.

OUTPUT CONTRACT
  Human-readable progress goes to stderr.
  stdout carries ONLY the machine-readable summary block, so
  `srr-qa-preflight all 2>/dev/null` is directly parseable:

    === SRR-QA-PREFLIGHT-SUMMARY ===
    PREFLIGHT_RESULT=OK|DEGRADED|BLOCKED
    PROJECT_ROOT=<path>
    REPO_OK=0|1
    METRO=UP|DOWN|PORT_BUSY_NOT_METRO|STARTED
    METRO_PORT=<n>
    METRO_PID=<pid or empty>
    IOS_STATUS=READY|BLOCKED|UNAVAILABLE|NOT_REQUESTED
    IOS_UDID=<udid or empty>
    IOS_DEVICE=<simulator name or empty>
    IOS_BUNDLE_ID=<id or empty>
    IOS_APP_INSTALLED=0|1
    IOS_LAUNCHED=0|1
    IOS_DEEPLINK_OPENED=0|1   1 = the app was cold-started via the dev-client
                               deep link. This does NOT prove the JS bundle
                               loaded - the dev client can still show "There was
                               a problem loading the project". Check the screen.
    IOS_LOGIN_STATE=LOGGED_IN|LOGGED_OUT|APP_NOT_RUNNING|UNKNOWN|<empty>
    IOS_DETAIL=<single-line note>
    IOS_FIX=<command to run by hand, when IOS_STATUS=BLOCKED>
    ANDROID_STATUS=READY|BLOCKED|UNAVAILABLE|NOT_REQUESTED
    ANDROID_SERIAL=<serial or empty>
    ANDROID_PACKAGE=<package or empty>
    ANDROID_APP_INSTALLED=0|1
    ANDROID_LAUNCHED=0|1
    ANDROID_DEEPLINK_OPENED=0|1
    ANDROID_LOGIN_STATE=<same value set as IOS_LOGIN_STATE>
    ANDROID_DETAIL=<single-line note>
    ANDROID_FIX=<command to run by hand, when ANDROID_STATUS=BLOCKED>
    METRO_DETAIL=<single-line note>
    REPO_DETAIL=<name@version>
    DEV_CLIENT_SCHEME=<scheme used for the deep link, or empty>
    EXIT_CODE=<n>
    === END-SUMMARY ===

  Every key above is always present (value may be empty). Values never contain
  newlines. Parse with: sed -n 's/^KEY=//p'.

  Platform status meanings:
    READY         device up, app installed, (launched unless --no-launch)
    BLOCKED       device is up but the app is not installed -> see *_FIX
    UNAVAILABLE   no device for this platform (not an error if you only wanted
                  the other platform)
    NOT_REQUESTED platform was not asked for

EXIT CODES
  0  OK       - every requested platform is READY
  1  DEGRADED - at least one requested platform READY, at least one not
                (only reachable with "all")
  2  usage error
  3  BLOCKED  - no requested platform is READY, or a global blocker hit
                (bad project root, Metro down, port occupied by something else)
  4  config error - a required config key is missing; the message names the
                exact key and env var

PREREQUISITES
  bash 3.2+, python3 (ships with macOS), and per platform:
    iOS     - Xcode command line tools (xcrun simctl). The app must already be
              installed on the simulator; this script will NOT run the native
              build because it takes many minutes. It prints the command.
    Android - adb on PATH, one emulator or device attached.
  Metro must be reachable, or pass --start-metro.

CONFIGURATION
  Resolution order, first hit wins:
    1. environment variable
    2. $PROJECT_ROOT/.claude/mobile-qa.local.json   (gitignored, secrets)
    3. $PROJECT_ROOT/.claude/mobile-qa.config.json  (committed, non-secret)
    4. built-in default (only where a universal default exists)

  Keys consumed by this script:
    metro.port              MOBILE_QA_METRO_PORT        default 8081
    metro.startCommand      MOBILE_QA_METRO_START_CMD   default "npm start"
    ios.bundleId            MOBILE_QA_IOS_BUNDLE_ID     required for ios
    ios.simulatorUdid       MOBILE_QA_IOS_UDID          optional
    ios.simulatorName       MOBILE_QA_IOS_DEVICE_NAME   used when udid is null
    ios.installCommand      MOBILE_QA_IOS_INSTALL_CMD   default
                            "npx expo run:ios --device {udid}"  ({udid} substituted)
    android.package         MOBILE_QA_ANDROID_PACKAGE   required for android
    android.serial          MOBILE_QA_ANDROID_SERIAL    optional
    android.installCommand  MOBILE_QA_ANDROID_INSTALL_CMD default
                            "npx expo run:android"
    devClient.scheme        MOBILE_QA_DEV_CLIENT_SCHEME optional; when unset it
                            is derived from app.json expo.scheme as
                            "exp+<scheme>" (with bare "<scheme>" as a fallback
                            candidate). Only used for the dev-client deep link.
    project.name            MOBILE_QA_PROJECT_NAME      optional sanity check
                            against package.json "name"

  Other env vars:
    MOBILE_QA_CONFIG        explicit path to a config json (replaces #3)
    MOBILE_QA_PROJECT_ROOT  explicit project root

  Nothing app-specific is hardcoded in this script. A missing required value is
  reported as a config error naming the key and env var, never guessed.
EOF
}

# ----------------------------------------------------------------------------
# Timeout helper (macOS has no coreutils `timeout`)
# ----------------------------------------------------------------------------
# run_to <secs> <outfile> <cmd...>  -> rc of cmd, or 124 on timeout
run_to() {
  local secs="$1" out="$2"; shift 2
  : >"$out"
  "$@" >"$out" 2>&1 &
  local pid=$! ticks=0 max=$((secs * 5)) rc=0
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$ticks" -ge "$max" ]; then
      kill -TERM "$pid" 2>/dev/null || true
      sleep 0.5
      kill -KILL "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      return 124
    fi
    sleep 0.2
    ticks=$((ticks + 1))
  done
  wait "$pid" || rc=$?
  return "$rc"
}

# ----------------------------------------------------------------------------
# Project root + config
# ----------------------------------------------------------------------------
resolve_project_root() {
  if [ -n "${MOBILE_QA_PROJECT_ROOT:-}" ]; then
    PROJECT_ROOT="$MOBILE_QA_PROJECT_ROOT"
    return 0
  fi
  local d
  d="$(pwd)"
  while [ "$d" != "/" ]; do
    if [ -f "$d/package.json" ]; then PROJECT_ROOT="$d"; return 0; fi
    d="$(dirname "$d")"
  done
  if d="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    PROJECT_ROOT="$d"; return 0
  fi
  PROJECT_ROOT="$(pwd)"
}

resolve_config_paths() {
  CFG_LOCAL="$PROJECT_ROOT/.claude/mobile-qa.local.json"
  if [ -n "${MOBILE_QA_CONFIG:-}" ]; then
    CFG_MAIN="$MOBILE_QA_CONFIG"
  else
    CFG_MAIN="$PROJECT_ROOT/.claude/mobile-qa.config.json"
  fi
}

cfg_scalar() {
  local key="$1"
  python3 - "$key" "$CFG_LOCAL" "$CFG_MAIN" <<'PY' 2>/dev/null || return 1
import json, os, sys
parts = sys.argv[1].split('.')
for path in sys.argv[2:]:
    if not path or not os.path.isfile(path):
        continue
    try:
        with open(path) as fh:
            data = json.load(fh)
    except Exception:
        continue
    cur = data
    ok = True
    for p in parts:
        if isinstance(cur, dict) and p in cur:
            cur = cur[p]
        else:
            ok = False
            break
    if ok and cur is not None and not isinstance(cur, (list, dict)):
        print(cur)
        sys.exit(0)
sys.exit(1)
PY
}

# cfg <dotted.key> <ENV_VAR_NAME> [default]
cfg() {
  local key="$1" env_name="$2" fallback="${3-}" v=""
  v="$(eval "printf '%s' \"\${$env_name:-}\"")"
  if [ -n "$v" ]; then printf '%s' "$v"; return 0; fi
  if v="$(cfg_scalar "$key")"; then printf '%s' "$v"; return 0; fi
  printf '%s' "$fallback"
}

config_error() {
  fail "$1"
  log "       set config key '$2' in $CFG_MAIN (or $CFG_LOCAL), or export $3"
  log ""
  log "A required project-specific value is missing. This script never guesses"
  log "bundle ids or simulator UDIDs."
  PREFLIGHT_RESULT=CONFIG_ERROR
  print_summary "$EX_CONFIG"
  exit "$EX_CONFIG"
}

load_config() {
  METRO_PORT="$(cfg 'metro.port' 'MOBILE_QA_METRO_PORT' '8081')"
  METRO_START_CMD="$(cfg 'metro.startCommand' 'MOBILE_QA_METRO_START_CMD' 'npm start')"
  IOS_INSTALL_CMD="$(cfg 'ios.installCommand' 'MOBILE_QA_IOS_INSTALL_CMD' 'npx expo run:ios --device {udid}')"
  ANDROID_INSTALL_CMD="$(cfg 'android.installCommand' 'MOBILE_QA_ANDROID_INSTALL_CMD' 'npx expo run:android')"
  case "$METRO_PORT" in
    ''|*[!0-9]*) log "error: metro port '$METRO_PORT' is not a number"; exit "$EX_CONFIG" ;;
  esac
}

# ----------------------------------------------------------------------------
# 1. project root
# ----------------------------------------------------------------------------
check_repo() {
  step "project root"
  vlog "PROJECT_ROOT=$PROJECT_ROOT"
  if [ ! -f "$PROJECT_ROOT/package.json" ]; then
    REPO_OK=0
    REPO_DETAIL="no package.json at $PROJECT_ROOT"
    fail "$REPO_DETAIL"
    log "       run from inside the project, or export MOBILE_QA_PROJECT_ROOT"
    return 1
  fi

  local info
  info="$(python3 - "$PROJECT_ROOT/package.json" <<'PY' 2>/dev/null || true
import json, sys
try:
    with open(sys.argv[1]) as fh:
        pkg = json.load(fh)
except Exception as exc:
    print("PARSE_ERROR|%s|" % exc)
    raise SystemExit(0)
deps = {}
for k in ('dependencies', 'devDependencies'):
    d = pkg.get(k)
    if isinstance(d, dict):
        deps.update(d)
rn = 'react-native' in deps or 'expo' in deps
print("%s|%s|%s" % ('OK' if rn else 'NOT_RN', pkg.get('name', ''), pkg.get('version', '')))
PY
)"
  local kind name version
  kind="${info%%|*}"
  name="$(printf '%s' "$info" | cut -d'|' -f2)"
  version="$(printf '%s' "$info" | cut -d'|' -f3)"

  if [ "$kind" = "PARSE_ERROR" ]; then
    REPO_OK=0
    REPO_DETAIL="package.json is not valid JSON"
    fail "$REPO_DETAIL"
    return 1
  fi
  if [ "$kind" = "NOT_RN" ]; then
    REPO_OK=0
    REPO_DETAIL="package.json has neither a react-native nor an expo dependency"
    fail "$REPO_DETAIL at $PROJECT_ROOT"
    return 1
  fi

  local expected
  expected="$(cfg 'project.name' 'MOBILE_QA_PROJECT_NAME' '')"
  if [ -n "$expected" ] && [ "$expected" != "$name" ]; then
    REPO_OK=0
    REPO_DETAIL="package.json name '$name' != expected '$expected'"
    fail "$REPO_DETAIL"
    log "       wrong project root? set MOBILE_QA_PROJECT_ROOT"
    return 1
  fi

  REPO_OK=1
  REPO_DETAIL="$name@$version"
  ok "$PROJECT_ROOT ($REPO_DETAIL)"
  return 0
}

# ----------------------------------------------------------------------------
# 2. metro
# ----------------------------------------------------------------------------
# metro_probe -> 0 if Metro answers on the port, 1 if nothing listening,
#                2 if something is listening but is not Metro
metro_probe() {
  local tmp rc=0
  tmp="$(mktemp)"
  vlog "curl -s -m 4 http://127.0.0.1:$METRO_PORT/status"
  run_to 10 "$tmp" curl -s -m 4 "http://127.0.0.1:$METRO_PORT/status" || rc=$?
  local body; body="$(tr -d '\r\n' <"$tmp")"
  rm -f "$tmp"

  METRO_PID="$(lsof -nP -iTCP:"$METRO_PORT" -sTCP:LISTEN -t 2>/dev/null | head -1 || true)"

  if [ "$rc" -eq 0 ] && printf '%s' "$body" | grep -q 'packager-status:running'; then
    return 0
  fi
  if [ -n "$METRO_PID" ]; then
    return 2
  fi
  METRO_PID=""
  return 1
}

check_metro() {
  step "metro (port $METRO_PORT)"
  local rc=0
  metro_probe || rc=$?

  if [ "$rc" -eq 0 ]; then
    METRO_STATE="UP"
    METRO_DETAIL="packager-status:running"
    ok "Metro is serving on $METRO_PORT (pid ${METRO_PID:-unknown})"
    return 0
  fi

  if [ "$rc" -eq 2 ]; then
    METRO_STATE="PORT_BUSY_NOT_METRO"
    METRO_DETAIL="pid $METRO_PID holds port $METRO_PORT but /status is not Metro"
    fail "$METRO_DETAIL"
    log "       kill it (kill $METRO_PID) or set metro.port / MOBILE_QA_METRO_PORT"
    return 1
  fi

  # nothing listening
  if [ "$START_METRO" -eq 0 ]; then
    METRO_STATE="DOWN"
    METRO_DETAIL="nothing listening on $METRO_PORT"
    fail "Metro is not running on port $METRO_PORT"
    log "       start it yourself:  cd $PROJECT_ROOT && $METRO_START_CMD"
    log "       or re-run:          $SCRIPT_NAME <platform> --start-metro"
    log "       (not started silently on purpose - an unexpected background"
    log "        process is worse than a clear error)"
    return 1
  fi

  local logfile="${TMPDIR:-/tmp}/mobile-qa-metro-$$.log"
  warn "starting Metro in the background: $METRO_START_CMD"
  warn "  log: $logfile"
  vlog "cd $PROJECT_ROOT && nohup $METRO_START_CMD"
  ( cd "$PROJECT_ROOT" && nohup sh -c "$METRO_START_CMD" >"$logfile" 2>&1 & echo $! >"${logfile}.pid" ) || true

  local waited=0
  while [ "$waited" -lt "$BOOT_TIMEOUT" ]; do
    rc=0; metro_probe || rc=$?
    if [ "$rc" -eq 0 ]; then
      METRO_STATE="STARTED"
      METRO_DETAIL="started in background, log $logfile"
      ok "Metro came up on $METRO_PORT (pid ${METRO_PID:-unknown})"
      return 0
    fi
    sleep 2
    waited=$((waited + 2))
  done

  METRO_STATE="DOWN"
  METRO_DETAIL="did not come up within ${BOOT_TIMEOUT}s, see $logfile"
  fail "Metro did not come up within ${BOOT_TIMEOUT}s"
  log "       check $logfile"
  return 1
}

# ----------------------------------------------------------------------------
# Expo dev-client deep link
# ----------------------------------------------------------------------------
# Launching an Expo dev-client by bundle id lands on the dev-launcher menu
# ("Development servers"), NOT in the app. To reach a testable screen the
# dev-client must be pointed at Metro via its deep link.
# Scheme resolution: devClient.scheme / MOBILE_QA_DEV_CLIENT_SCHEME, else
# derived from app.json expo.scheme as "exp+<scheme>" (that is the scheme
# expo-dev-client registers), with the bare "<scheme>" as a second candidate.
DEV_SCHEME_CANDIDATES=()

resolve_dev_scheme() {
  DEV_SCHEME_CANDIDATES=()
  local configured
  configured="$(cfg 'devClient.scheme' 'MOBILE_QA_DEV_CLIENT_SCHEME' '')"
  if [ -n "$configured" ]; then
    DEV_CLIENT_SCHEME="$configured"
    DEV_SCHEME_CANDIDATES=("$configured")
    return 0
  fi
  local s=""
  if [ -f "$PROJECT_ROOT/app.json" ]; then
    s="$(python3 - "$PROJECT_ROOT/app.json" <<'PY' 2>/dev/null || true
import json, sys
try:
    with open(sys.argv[1]) as fh:
        d = json.load(fh)
except Exception:
    raise SystemExit(0)
expo = d.get('expo', d)
sch = expo.get('scheme')
if isinstance(sch, list):
    sch = sch[0] if sch else None
print(sch or '')
PY
)"
  fi
  if [ -n "$s" ]; then
    DEV_CLIENT_SCHEME="exp+$s"
    DEV_SCHEME_CANDIDATES=("exp+$s" "$s")
    return 0
  fi
  return 1
}

dev_client_url() {
  local scheme="$1" host="$2"
  printf '%s://expo-development-client/?url=http%%3A%%2F%%2F%s%%3A%s' \
    "$scheme" "$host" "$METRO_PORT"
}

# ----------------------------------------------------------------------------
# 3. iOS
# ----------------------------------------------------------------------------
ios_resolve_udid() {
  if [ -n "$OVERRIDE_UDID" ]; then IOS_UDID="$OVERRIDE_UDID"; return 0; fi
  IOS_UDID="$(cfg 'ios.simulatorUdid' 'MOBILE_QA_IOS_UDID' '')"
  IOS_DEVICE_NAME="$(cfg 'ios.simulatorName' 'MOBILE_QA_IOS_DEVICE_NAME' '')"
  if [ -n "$IOS_UDID" ]; then return 0; fi
  if [ -z "$IOS_DEVICE_NAME" ]; then
    config_error "no iOS simulator identified" \
      "ios.simulatorUdid (or ios.simulatorName)" \
      "MOBILE_QA_IOS_UDID (or MOBILE_QA_IOS_DEVICE_NAME)"
  fi

  local tmp rc=0; tmp="$(mktemp)"
  vlog "xcrun simctl list devices available"
  run_to "$CMD_TIMEOUT" "$tmp" xcrun simctl list devices available || rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$tmp"
    IOS_STATUS="UNAVAILABLE"
    IOS_DETAIL="xcrun simctl list devices failed (rc=$rc)"
    fail "$IOS_DETAIL"
    return 1
  fi
  IOS_UDID="$(python3 - "$IOS_DEVICE_NAME" "$tmp" <<'PY'
import re, sys
name, path = sys.argv[1], sys.argv[2]
booted = any_match = None
with open(path, encoding='utf-8', errors='replace') as fh:
    for line in fh:
        m = re.match(r'\s*(.+?)\s+\(([0-9A-Fa-f-]{36})\)\s+\((\w+)\)', line)
        if not m:
            continue
        dev, udid, state = m.group(1).strip(), m.group(2), m.group(3)
        if dev != name:
            continue
        if any_match is None:
            any_match = udid
        if state == 'Booted' and booted is None:
            booted = udid
print(booted or any_match or '')
PY
)"
  rm -f "$tmp"
  if [ -z "$IOS_UDID" ]; then
    IOS_STATUS="UNAVAILABLE"
    IOS_DETAIL="no simulator named '$IOS_DEVICE_NAME'"
    fail "$IOS_DETAIL"
    log "       list them with: xcrun simctl list devices available"
    return 1
  fi
  ok "resolved simulator '$IOS_DEVICE_NAME' -> $IOS_UDID"
  return 0
}

ios_device_state() {
  local tmp rc=0; tmp="$(mktemp)"
  run_to "$CMD_TIMEOUT" "$tmp" xcrun simctl list devices || rc=$?
  if [ "$rc" -ne 0 ]; then rm -f "$tmp"; printf 'ERROR'; return 0; fi
  local line; line="$(grep -F "$IOS_UDID" "$tmp" | head -1 || true)"
  rm -f "$tmp"
  if [ -z "$line" ]; then printf 'MISSING'; return 0; fi
  case "$line" in
    *"(Booted)"*)       printf 'Booted' ;;
    *"(Shutdown)"*)     printf 'Shutdown' ;;
    *"(Booting)"*)      printf 'Booting' ;;
    *"(Shutting Down)"*) printf 'ShuttingDown' ;;
    *)                  printf 'Other' ;;
  esac
}

do_ios() {
  step "ios"
  if ! command -v xcrun >/dev/null 2>&1; then
    IOS_STATUS="UNAVAILABLE"
    IOS_DETAIL="xcrun not on PATH (Xcode command line tools required)"
    fail "$IOS_DETAIL"
    return 1
  fi

  IOS_BUNDLE_ID="$(cfg 'ios.bundleId' 'MOBILE_QA_IOS_BUNDLE_ID' '')"
  [ -n "$IOS_BUNDLE_ID" ] || config_error "iOS bundle id is not configured" \
    "ios.bundleId" "MOBILE_QA_IOS_BUNDLE_ID"

  ios_resolve_udid || return 1

  # --- boot ---
  local dstate; dstate="$(ios_device_state)"
  vlog "simulator state: $dstate"
  case "$dstate" in
    MISSING)
      IOS_STATUS="UNAVAILABLE"
      IOS_DETAIL="simulator $IOS_UDID does not exist"
      fail "$IOS_DETAIL"
      log "       list them with: xcrun simctl list devices"
      return 1
      ;;
    ERROR)
      IOS_STATUS="UNAVAILABLE"
      IOS_DETAIL="could not read simulator list"
      fail "$IOS_DETAIL"
      return 1
      ;;
    Booted)
      ok "simulator already booted ($IOS_UDID)"
      ;;
    *)
      warn "booting simulator $IOS_UDID ..."
      local tmp rc=0; tmp="$(mktemp)"
      vlog "xcrun simctl boot $IOS_UDID"
      run_to "$CMD_TIMEOUT" "$tmp" xcrun simctl boot "$IOS_UDID" || rc=$?
      # "Unable to boot device in current state: Booted" is benign
      if [ "$rc" -ne 0 ] && ! grep -qi 'current state: Booted' "$tmp"; then
        IOS_DETAIL="$(oneline "boot failed: $(head -2 "$tmp")")"
        rm -f "$tmp"
        IOS_STATUS="UNAVAILABLE"
        fail "$IOS_DETAIL"
        return 1
      fi
      rm -f "$tmp"

      local waited=0
      while [ "$waited" -lt "$BOOT_TIMEOUT" ]; do
        [ "$(ios_device_state)" = "Booted" ] && break
        sleep 2
        waited=$((waited + 2))
      done
      if [ "$(ios_device_state)" != "Booted" ]; then
        IOS_STATUS="UNAVAILABLE"
        IOS_DETAIL="simulator did not reach Booted within ${BOOT_TIMEOUT}s"
        fail "$IOS_DETAIL"
        return 1
      fi
      ok "simulator booted (${waited}s)"
      ;;
  esac

  # Wait for the runtime to actually accept work, bounded.
  local tmp rc=0 waited=0
  while [ "$waited" -lt "$BOOT_TIMEOUT" ]; do
    tmp="$(mktemp)"; rc=0
    run_to 15 "$tmp" xcrun simctl getenv "$IOS_UDID" HOME || rc=$?
    rm -f "$tmp"
    [ "$rc" -eq 0 ] && break
    sleep 2
    waited=$((waited + 2))
  done
  [ "$rc" -eq 0 ] || warn "simulator is Booted but still not answering simctl; continuing anyway"

  if [ "$OPEN_SIMULATOR_APP" -eq 1 ]; then
    vlog "open -a Simulator"
    open -a Simulator >/dev/null 2>&1 || warn "could not bring Simulator.app to the front"
  fi

  # --- installed? ---
  tmp="$(mktemp)"; rc=0
  vlog "xcrun simctl get_app_container $IOS_UDID $IOS_BUNDLE_ID app"
  run_to "$CMD_TIMEOUT" "$tmp" xcrun simctl get_app_container "$IOS_UDID" "$IOS_BUNDLE_ID" app || rc=$?
  rm -f "$tmp"
  if [ "$rc" -ne 0 ]; then
    IOS_APP_INSTALLED=0
    IOS_STATUS="BLOCKED"
    IOS_FIX="$(printf '%s' "$IOS_INSTALL_CMD" | sed "s|{udid}|$IOS_UDID|g")"
    IOS_DETAIL="$IOS_BUNDLE_ID is not installed on $IOS_UDID"
    fail "$IOS_DETAIL"
    log ""
    log "       MANUAL STEP REQUIRED - run this yourself, it takes minutes:"
    log "         cd $PROJECT_ROOT && $IOS_FIX"
    log "       (this script does not run native builds on your behalf)"
    return 1
  fi
  IOS_APP_INSTALLED=1
  ok "$IOS_BUNDLE_ID is installed"

  # --- launch ---
  # Verified on expo-dev-launcher 6.0.20: openurl on an ALREADY RUNNING dev
  # client is delivered but ignored - the launcher menu stays put. The URL is
  # only honoured on a cold start. So: terminate, then openurl (which itself
  # cold-launches the app with the URL attached).
  if [ "$DO_LAUNCH" -eq 1 ]; then
    local out scheme url opened=0
    if [ "$DO_CONNECT" -eq 1 ] && resolve_dev_scheme; then
      tmp="$(mktemp)"
      vlog "xcrun simctl terminate $IOS_UDID $IOS_BUNDLE_ID"
      run_to "$CMD_TIMEOUT" "$tmp" xcrun simctl terminate "$IOS_UDID" "$IOS_BUNDLE_ID" || true
      rm -f "$tmp"
      sleep 1

      for scheme in "${DEV_SCHEME_CANDIDATES[@]}"; do
        url="$(dev_client_url "$scheme" localhost)"
        tmp="$(mktemp)"; rc=0
        vlog "xcrun simctl openurl $IOS_UDID \"$url\""
        run_to "$CMD_TIMEOUT" "$tmp" xcrun simctl openurl "$IOS_UDID" "$url" || rc=$?
        out="$(oneline "$(head -2 "$tmp")")"
        rm -f "$tmp"
        if [ "$rc" -eq 0 ]; then
          DEV_CLIENT_SCHEME="$scheme"
          opened=1
          break
        fi
        vlog "scheme '$scheme' rejected: $out"
      done

      if [ "$opened" -eq 1 ]; then
        IOS_DEEPLINK_OPENED=1
        ok "cold-started via dev-client deep link ($DEV_CLIENT_SCHEME -> localhost:$METRO_PORT)"
        # give the dev client time to fetch and evaluate the bundle
        sleep 8
      else
        warn "no dev-client scheme accepted the deep link; falling back to a plain launch"
        warn "  set devClient.scheme / MOBILE_QA_DEV_CLIENT_SCHEME if the app stays on the launcher menu"
      fi
    fi

    if [ "$opened" -eq 0 ]; then
      tmp="$(mktemp)"; rc=0
      vlog "xcrun simctl launch $IOS_UDID $IOS_BUNDLE_ID"
      run_to "$CMD_TIMEOUT" "$tmp" xcrun simctl launch "$IOS_UDID" "$IOS_BUNDLE_ID" || rc=$?
      out="$(oneline "$(head -2 "$tmp")")"
      rm -f "$tmp"
      if [ "$rc" -ne 0 ]; then
        IOS_LAUNCHED=0
        warn "launch returned rc=$rc: $out"
        IOS_DETAIL="$(oneline "launch failed: $out")"
      else
        ok "launched ($out)"
      fi
    fi

    # confirm the process is actually up, however we started it
    tmp="$(mktemp)"; rc=0
    run_to "$CMD_TIMEOUT" "$tmp" xcrun simctl spawn "$IOS_UDID" launchctl list || rc=$?
    if [ "$rc" -eq 0 ] && grep -q "UIKitApplication:$IOS_BUNDLE_ID" "$tmp"; then
      IOS_LAUNCHED=1
      ok "app process is running"
    else
      IOS_LAUNCHED=0
      warn "app process is not running after launch"
      IOS_DETAIL="app process not running after launch"
    fi
    rm -f "$tmp"
  else
    IOS_DETAIL="launch skipped (--no-launch)"
    warn "$IOS_DETAIL"
  fi

  IOS_STATUS="READY"
  [ -n "$IOS_DETAIL" ] || IOS_DETAIL="ready"
  return 0
}

# ----------------------------------------------------------------------------
# 4. Android
# ----------------------------------------------------------------------------
do_android() {
  step "android"
  if ! command -v adb >/dev/null 2>&1; then
    ANDROID_STATUS="UNAVAILABLE"
    ANDROID_DETAIL="adb not on PATH (Android platform-tools required)"
    fail "$ANDROID_DETAIL"
    return 1
  fi

  ANDROID_PACKAGE="$(cfg 'android.package' 'MOBILE_QA_ANDROID_PACKAGE' '')"
  [ -n "$ANDROID_PACKAGE" ] || config_error "Android package is not configured" \
    "android.package" "MOBILE_QA_ANDROID_PACKAGE"

  # --- device ---
  if [ -n "$OVERRIDE_SERIAL" ]; then
    ANDROID_SERIAL="$OVERRIDE_SERIAL"
  else
    ANDROID_SERIAL="$(cfg 'android.serial' 'MOBILE_QA_ANDROID_SERIAL' '')"
  fi

  local tmp rc=0; tmp="$(mktemp)"
  vlog "adb devices"
  run_to "$CMD_TIMEOUT" "$tmp" adb devices || rc=$?
  if [ "$rc" -ne 0 ]; then
    local out; out="$(oneline "$(head -3 "$tmp")")"
    rm -f "$tmp"
    ANDROID_STATUS="UNAVAILABLE"
    ANDROID_DETAIL="$(oneline "adb devices failed (rc=$rc): $out")"
    fail "$ANDROID_DETAIL"
    return 1
  fi
  local usable bad count=0
  usable="$(awk 'NR>1 && $2=="device" {print $1}' "$tmp")"
  bad="$(awk 'NR>1 && NF>=2 && $2!="device" {print $1"("$2")"}' "$tmp" | tr '\n' ' ')"
  rm -f "$tmp"
  [ -n "$usable" ] && count="$(printf '%s\n' "$usable" | wc -l | tr -d ' ')"

  if [ -n "$ANDROID_SERIAL" ]; then
    if ! printf '%s\n' "$usable" | grep -qx "$ANDROID_SERIAL"; then
      ANDROID_STATUS="UNAVAILABLE"
      ANDROID_DETAIL="configured serial '$ANDROID_SERIAL' is not in 'device' state"
      fail "$ANDROID_DETAIL"
      [ -n "$bad" ] && log "       non-usable entries: $bad"
      return 1
    fi
  else
    if [ "$count" -eq 0 ]; then
      ANDROID_STATUS="UNAVAILABLE"
      ANDROID_DETAIL="no adb device attached"
      if [ -n "$bad" ]; then
        ANDROID_DETAIL="no usable adb device; saw: $(oneline "$bad")"
      fi
      fail "$ANDROID_DETAIL"
      log "       start an emulator, or plug in a device and accept the USB debugging prompt"
      return 1
    fi
    if [ "$count" -gt 1 ]; then
      ANDROID_STATUS="UNAVAILABLE"
      ANDROID_DETAIL="$count adb devices; pick one"
      fail "$ANDROID_DETAIL: $(oneline "$(printf '%s' "$usable" | tr '\n' ' ')")"
      log "       re-run with --serial <serial>, or set android.serial / MOBILE_QA_ANDROID_SERIAL"
      return 1
    fi
    ANDROID_SERIAL="$usable"
  fi
  ok "device $ANDROID_SERIAL"

  # boot completed?
  tmp="$(mktemp)"; rc=0
  vlog "adb -s $ANDROID_SERIAL shell getprop sys.boot_completed"
  run_to "$CMD_TIMEOUT" "$tmp" adb -s "$ANDROID_SERIAL" shell getprop sys.boot_completed || rc=$?
  local booted; booted="$(tr -d '\r' <"$tmp" | tr -d '[:space:]')"
  rm -f "$tmp"
  if [ "$booted" != "1" ]; then
    warn "sys.boot_completed='$booted', waiting for boot ..."
    local waited=0
    while [ "$waited" -lt "$BOOT_TIMEOUT" ]; do
      tmp="$(mktemp)"; rc=0
      run_to 15 "$tmp" adb -s "$ANDROID_SERIAL" shell getprop sys.boot_completed || rc=$?
      booted="$(tr -d '\r' <"$tmp" | tr -d '[:space:]')"
      rm -f "$tmp"
      [ "$booted" = "1" ] && break
      sleep 2
      waited=$((waited + 2))
    done
    if [ "$booted" != "1" ]; then
      ANDROID_STATUS="UNAVAILABLE"
      ANDROID_DETAIL="device did not finish booting within ${BOOT_TIMEOUT}s"
      fail "$ANDROID_DETAIL"
      return 1
    fi
    ok "device finished booting (${waited}s)"
  fi

  # --- installed? ---
  tmp="$(mktemp)"; rc=0
  vlog "adb -s $ANDROID_SERIAL shell pm list packages $ANDROID_PACKAGE"
  run_to "$CMD_TIMEOUT" "$tmp" adb -s "$ANDROID_SERIAL" shell pm list packages "$ANDROID_PACKAGE" || rc=$?
  if [ "$rc" -ne 0 ] || ! tr -d '\r' <"$tmp" | grep -qx "package:$ANDROID_PACKAGE"; then
    rm -f "$tmp"
    ANDROID_APP_INSTALLED=0
    ANDROID_STATUS="BLOCKED"
    ANDROID_FIX="$ANDROID_INSTALL_CMD"
    ANDROID_DETAIL="$ANDROID_PACKAGE is not installed on $ANDROID_SERIAL"
    fail "$ANDROID_DETAIL"
    log ""
    log "       MANUAL STEP REQUIRED - run this yourself, it takes minutes:"
    log "         cd $PROJECT_ROOT && $ANDROID_FIX"
    return 1
  fi
  rm -f "$tmp"
  ANDROID_APP_INSTALLED=1
  ok "$ANDROID_PACKAGE is installed"

  # --- launch ---
  # Same cold-start rule as iOS: a dev-client that is already running ignores
  # the deep link, so force-stop first and let the VIEW intent start it.
  # `adb reverse` makes localhost resolve on emulators and physical devices
  # alike, so no 10.0.2.2 special-casing is needed.
  if [ "$DO_LAUNCH" -eq 1 ]; then
    local out scheme url opened=0
    if [ "$DO_CONNECT" -eq 1 ] && resolve_dev_scheme; then
      tmp="$(mktemp)"; rc=0
      vlog "adb -s $ANDROID_SERIAL reverse tcp:$METRO_PORT tcp:$METRO_PORT"
      run_to "$CMD_TIMEOUT" "$tmp" adb -s "$ANDROID_SERIAL" reverse \
        "tcp:$METRO_PORT" "tcp:$METRO_PORT" || rc=$?
      [ "$rc" -eq 0 ] || warn "adb reverse failed (rc=$rc): $(oneline "$(head -1 "$tmp")")"
      rm -f "$tmp"

      tmp="$(mktemp)"
      vlog "adb -s $ANDROID_SERIAL shell am force-stop $ANDROID_PACKAGE"
      run_to "$CMD_TIMEOUT" "$tmp" adb -s "$ANDROID_SERIAL" shell am force-stop "$ANDROID_PACKAGE" || true
      rm -f "$tmp"

      for scheme in "${DEV_SCHEME_CANDIDATES[@]}"; do
        url="$(dev_client_url "$scheme" localhost)"
        tmp="$(mktemp)"; rc=0
        vlog "adb -s $ANDROID_SERIAL shell am start -W -a android.intent.action.VIEW -d \"$url\""
        run_to "$CMD_TIMEOUT" "$tmp" adb -s "$ANDROID_SERIAL" shell am start -W \
          -a android.intent.action.VIEW -d "$url" || rc=$?
        out="$(oneline "$(tr -d '\r' <"$tmp" | grep -v '^$' | tail -2)")"
        rm -f "$tmp"
        if [ "$rc" -eq 0 ] && ! printf '%s' "$out" | grep -qi 'Error\|unable to resolve'; then
          DEV_CLIENT_SCHEME="$scheme"
          opened=1
          break
        fi
        vlog "scheme '$scheme' rejected: $out"
      done

      if [ "$opened" -eq 1 ]; then
        ANDROID_DEEPLINK_OPENED=1
        ok "cold-started via dev-client deep link ($DEV_CLIENT_SCHEME -> localhost:$METRO_PORT)"
        sleep 8
      else
        warn "no dev-client scheme accepted the deep link; falling back to a plain launch"
      fi
    fi

    if [ "$opened" -eq 0 ]; then
      tmp="$(mktemp)"; rc=0
      vlog "adb -s $ANDROID_SERIAL shell monkey -p $ANDROID_PACKAGE -c android.intent.category.LAUNCHER 1"
      run_to "$CMD_TIMEOUT" "$tmp" adb -s "$ANDROID_SERIAL" shell monkey -p "$ANDROID_PACKAGE" \
        -c android.intent.category.LAUNCHER 1 || rc=$?
      out="$(oneline "$(grep -v '^$' "$tmp" | tail -1)")"
      rm -f "$tmp"
      if [ "$rc" -eq 0 ] && ! printf '%s' "$out" | grep -qi 'No activities found\|Error'; then
        ok "launched via LAUNCHER intent"
        sleep 3
      else
        warn "launch may have failed: $out"
        ANDROID_DETAIL="$(oneline "launch warning: $out")"
      fi
    fi

    # confirm the process is actually up, however we started it
    tmp="$(mktemp)"; rc=0
    run_to "$CMD_TIMEOUT" "$tmp" adb -s "$ANDROID_SERIAL" shell pidof "$ANDROID_PACKAGE" || rc=$?
    if [ -n "$(tr -d '\r' <"$tmp" | tr -d '[:space:]')" ]; then
      ANDROID_LAUNCHED=1
      ok "app process is running"
    else
      ANDROID_LAUNCHED=0
      warn "app process is not running after launch"
      ANDROID_DETAIL="app process not running after launch"
    fi
    rm -f "$tmp"
  else
    ANDROID_DETAIL="launch skipped (--no-launch)"
    warn "$ANDROID_DETAIL"
  fi

  ANDROID_STATUS="READY"
  [ -n "$ANDROID_DETAIL" ] || ANDROID_DETAIL="ready"
  return 0
}

# ----------------------------------------------------------------------------
# 5. login state (delegated to srr-qa-state)
# ----------------------------------------------------------------------------
report_login_state() {
  local platform="$1" extra_flag="$2" extra_val="$3"
  if [ ! -x "$STATE_BIN" ]; then
    warn "srr-qa-state not found or not executable at $STATE_BIN"
    printf 'UNKNOWN'
    return 0
  fi
  local tmp rc=0; tmp="$(mktemp)"
  local -a args=("$platform")
  [ "$VERBOSE" -eq 1 ] && args+=("-v")
  [ -n "$extra_flag" ] && args+=("$extra_flag" "$extra_val")
  vlog "$STATE_BIN ${args[*]}"
  # srr-qa-state uses exit codes to signal state; never let that abort us.
  "$STATE_BIN" "${args[@]}" >"$tmp" 2>&1 || rc=$?
  local st; st="$(sed -n 's/^STATE=//p' "$tmp" | head -1)"
  local reason; reason="$(sed -n 's/^REASON=//p' "$tmp" | head -1)"
  local shot; shot="$(sed -n 's/^SCREENSHOT=//p' "$tmp" | head -1)"
  local note; note="$(sed -n 's/^NOTE=//p' "$tmp" | head -1)"
  rm -f "$tmp"
  [ -n "$st" ] || st="UNKNOWN"
  ok "login state: $st (${reason:-no-reason}, srr-qa-state rc=$rc)"
  [ -n "$note" ] && log "         $note"
  [ -n "$shot" ] && log "         screenshot: $shot"
  printf '%s' "$st"
}

# ----------------------------------------------------------------------------
# summary
# ----------------------------------------------------------------------------
PREFLIGHT_RESULT="BLOCKED"

print_summary() {
  local code="$1"
  cat <<EOF
=== SRR-QA-PREFLIGHT-SUMMARY ===
PREFLIGHT_RESULT=$PREFLIGHT_RESULT
PROJECT_ROOT=$PROJECT_ROOT
REPO_OK=$REPO_OK
METRO=$METRO_STATE
METRO_PORT=$METRO_PORT
METRO_PID=$METRO_PID
IOS_STATUS=$IOS_STATUS
IOS_UDID=$IOS_UDID
IOS_DEVICE=$IOS_DEVICE_NAME
IOS_BUNDLE_ID=$IOS_BUNDLE_ID
IOS_APP_INSTALLED=$IOS_APP_INSTALLED
IOS_LAUNCHED=$IOS_LAUNCHED
IOS_DEEPLINK_OPENED=$IOS_DEEPLINK_OPENED
IOS_LOGIN_STATE=$IOS_LOGIN_STATE
IOS_DETAIL=$(oneline "$IOS_DETAIL")
IOS_FIX=$(oneline "$IOS_FIX")
ANDROID_STATUS=$ANDROID_STATUS
ANDROID_SERIAL=$ANDROID_SERIAL
ANDROID_PACKAGE=$ANDROID_PACKAGE
ANDROID_APP_INSTALLED=$ANDROID_APP_INSTALLED
ANDROID_LAUNCHED=$ANDROID_LAUNCHED
ANDROID_DEEPLINK_OPENED=$ANDROID_DEEPLINK_OPENED
ANDROID_LOGIN_STATE=$ANDROID_LOGIN_STATE
ANDROID_DETAIL=$(oneline "$ANDROID_DETAIL")
ANDROID_FIX=$(oneline "$ANDROID_FIX")
DEV_CLIENT_SCHEME=$DEV_CLIENT_SCHEME
METRO_DETAIL=$(oneline "$METRO_DETAIL")
REPO_DETAIL=$(oneline "$REPO_DETAIL")
EXIT_CODE=$code
=== END-SUMMARY ===
EOF
}

finish() {
  local code="$1"
  print_summary "$code"
  exit "$code"
}

# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------
main() {
  local platform_arg=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      ios|android|all)
        [ -z "$platform_arg" ] || die_usage "platform given twice ('$platform_arg' and '$1')"
        platform_arg="$1"; shift ;;
      -v|--verbose) VERBOSE=1; shift ;;
      --start-metro) START_METRO=1; shift ;;
      --no-launch) DO_LAUNCH=0; shift ;;
      --no-connect) DO_CONNECT=0; shift ;;
      --no-open-sim) OPEN_SIMULATOR_APP=0; shift ;;
      --udid) [ "$#" -ge 2 ] || die_usage "--udid needs a value"; OVERRIDE_UDID="$2"; shift 2 ;;
      --serial) [ "$#" -ge 2 ] || die_usage "--serial needs a value"; OVERRIDE_SERIAL="$2"; shift 2 ;;
      --boot-timeout) [ "$#" -ge 2 ] || die_usage "--boot-timeout needs a value"; BOOT_TIMEOUT="$2"; shift 2 ;;
      --timeout) [ "$#" -ge 2 ] || die_usage "--timeout needs a value"; CMD_TIMEOUT="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die_usage "unknown argument '$1'" ;;
    esac
  done
  [ -n "$platform_arg" ] || platform_arg="all"

  local n
  for n in "$BOOT_TIMEOUT" "$CMD_TIMEOUT"; do
    case "$n" in
      ''|*[!0-9]*) die_usage "timeouts must be positive integers" ;;
    esac
    [ "$n" -gt 0 ] || die_usage "timeouts must be positive integers"
  done

  case "$platform_arg" in
    ios)     WANT_IOS=1 ;;
    android) WANT_ANDROID=1 ;;
    all)     WANT_IOS=1; WANT_ANDROID=1 ;;
  esac

  command -v python3 >/dev/null 2>&1 || { log "error: python3 is required"; exit "$EX_BLOCKED"; }

  resolve_project_root
  resolve_config_paths
  load_config

  log "srr-qa-preflight: platform=$platform_arg"
  vlog "config: $CFG_MAIN"
  vlog "local overlay: $CFG_LOCAL"
  [ -f "$CFG_MAIN" ] || warn "no config at $CFG_MAIN (relying on env vars / defaults)"

  # global blockers
  if ! check_repo; then
    PREFLIGHT_RESULT="BLOCKED"
    [ "$WANT_IOS" -eq 1 ] && { IOS_STATUS="UNAVAILABLE"; IOS_DETAIL="skipped: project root check failed"; }
    [ "$WANT_ANDROID" -eq 1 ] && { ANDROID_STATUS="UNAVAILABLE"; ANDROID_DETAIL="skipped: project root check failed"; }
    log ""
    log "RESULT: BLOCKED (project root)"
    finish "$EX_BLOCKED"
  fi

  if ! check_metro; then
    PREFLIGHT_RESULT="BLOCKED"
    [ "$WANT_IOS" -eq 1 ] && { IOS_STATUS="UNAVAILABLE"; IOS_DETAIL="skipped: Metro unavailable"; }
    [ "$WANT_ANDROID" -eq 1 ] && { ANDROID_STATUS="UNAVAILABLE"; ANDROID_DETAIL="skipped: Metro unavailable"; }
    log ""
    log "RESULT: BLOCKED (Metro). The dev client cannot load JS without it."
    finish "$EX_BLOCKED"
  fi

  if [ "$WANT_IOS" -eq 1 ]; then
    if do_ios; then
      step "ios login state"
      IOS_LOGIN_STATE="$(report_login_state ios --udid "$IOS_UDID")"
    fi
  fi

  if [ "$WANT_ANDROID" -eq 1 ]; then
    if do_android; then
      step "android login state"
      ANDROID_LOGIN_STATE="$(report_login_state android --serial "$ANDROID_SERIAL")"
    fi
  fi

  # verdict
  local ready=0 notready=0
  if [ "$WANT_IOS" -eq 1 ]; then
    if [ "$IOS_STATUS" = "READY" ]; then ready=$((ready + 1)); else notready=$((notready + 1)); fi
  fi
  if [ "$WANT_ANDROID" -eq 1 ]; then
    if [ "$ANDROID_STATUS" = "READY" ]; then ready=$((ready + 1)); else notready=$((notready + 1)); fi
  fi

  local code
  if [ "$ready" -gt 0 ] && [ "$notready" -eq 0 ]; then
    PREFLIGHT_RESULT="OK"; code="$EX_OK"
  elif [ "$ready" -gt 0 ]; then
    PREFLIGHT_RESULT="DEGRADED"; code="$EX_DEGRADED"
  else
    PREFLIGHT_RESULT="BLOCKED"; code="$EX_BLOCKED"
  fi

  log ""
  log "RESULT: $PREFLIGHT_RESULT  (ios=$IOS_STATUS android=$ANDROID_STATUS)"
  if [ "$PREFLIGHT_RESULT" = "DEGRADED" ]; then
    log "One platform is usable. Test that one; do not block on the other."
  fi
  finish "$code"
}

main "$@"
